# ForensicAP kernel config overlay — rpi-2712 variant (Pi 5 / CM5, 16k pages).
#
# Applied via `scripts/kconfig/merge_config.sh -m .config forensicap/v8-16k.config`
# on top of bcm2712_defconfig.  Mirrors v8.config — the regdb and LOCALVERSION
# tweaks are not arch-variant-specific.  Kept as a separate file so future
# Pi-5-only tweaks can land here without touching the rpi-v8 build.

# ── Unsigned regulatory database ─────────────────────────────────────────────
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n

# ── Identifiable build string ────────────────────────────────────────────────
# bcm2712_defconfig already sets CONFIG_LOCALVERSION="-v8-16k" so the merged
# value lands as "-v8-16k-forensicap" (uname -r will read
# "6.12.<minor>-v8-16k-forensicap").
CONFIG_LOCALVERSION="-forensicap"
CONFIG_LOCALVERSION_AUTO=n
