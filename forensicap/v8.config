# ForensicAP kernel config overlay — rpi-v8 variant (Pi 4 / CM4 / Zero 2 W).
#
# Applied via `scripts/kconfig/merge_config.sh -m .config forensicap/v8.config`
# on top of bcm2711_defconfig.  All ForensicAP-specific tweaks live here so the
# rest of the rpi-6.12.y branch can stay a clean mirror of raspberrypi/linux.

# ── Unsigned regulatory database ─────────────────────────────────────────────
# Allow cfg80211 to load /lib/firmware/regulatory.db without verifying its
# attached PKCS#7 signature.  We ship a permissive regulatory.db that grants
# country "00" (worldwide) on a wide channel/power matrix — the upstream
# linux-firmware regulatory.db is too restrictive for forensic workflows
# (monitor mode, packet injection on bands outside DE regulatory domain).
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n

# ── Identifiable build string ────────────────────────────────────────────────
# Kernel version string becomes "<upstream>-v8-forensicap" so that the running
# kernel can be distinguished from a stock raspberrypi-kernel install at a
# glance (uname -r) and stage 1c can verify the custom kernel actually booted.
CONFIG_LOCALVERSION="-forensicap"

# scripts/setlocalversion appends "+" to the kernel version on shallow clones
# without a matching annotated tag.  CI uses fetch-depth: 1, which triggers
# that behaviour, producing unstable kver strings like "6.12.90-v8-forensicap+".
# An unstable kver breaks the deb package version + DKMS lookup paths.
CONFIG_LOCALVERSION_AUTO=n
